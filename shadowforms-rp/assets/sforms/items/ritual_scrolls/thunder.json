{
  "model": {
    "type": "minecraft:select",
    "cases": [
      {
        "when": [
          "firstperson_lefthand",
          "firstperson_righthand",
          "fixed"
        ],
        "model": {
          "type": "condition",
          "on_true": {
            "type": "minecraft:model",
            "model": "sforms:item/ritual_scroll/3d_thunder_2"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "sforms:item/ritual_scroll/3d_thunder_1"
          },
          "property": "keybind_down",
          "keybind": "key.sneak"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "sforms:item/ritual_scroll/open_ritual_scroll"
    },
    "property": "minecraft:display_context"
  }
}